# Copier ce fichier en `.env` et renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité (déjà dans .gitignore).

# Anthropic — analyses LLM (Agents 2, 3 et 5). Obligatoire.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Finnhub — actualités financières (Agent 2). Plan gratuit : 60 appels/min.
# https://finnhub.io/
FINNHUB_API_KEY=

# NewsAPI — actualités financières (Agent 2). Plan gratuit : 100 requêtes/jour.
# https://newsapi.org/
NEWSAPI_KEY=
